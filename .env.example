APP_NAME="大师投研室"

# Data source. Set false for fully offline deterministic demo data.
ENABLE_AKSHARE=true

# LLM config.
# Keep mock mode if you do not have an API key.
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL="deepseek-v4-pro"

# Master decision mode:
# - rules: deterministic local scoring only
# - hybrid: LLM decision with rule guardrails when an API key is configured
MASTER_DECISION_MODE="hybrid"
MASTER_LLM_MAX_SCORE_DELTA=0.18

# Example DeepSeek-compatible settings:
# LLM_PROVIDER="deepseek"
# LLM_API_KEY="replace-with-your-own-key"
# LLM_BASE_URL="https://api.deepseek.com"
# LLM_MODEL="deepseek-v4-pro"
